# Huawei
HUAWEI_CLIENT_ID=your-huawei-client-id
HUAWEI_CLIENT_SECRET=change-this-huawei-client-secret
HUAWEI_REDIRECT_URI=https://example.com/api/auth/huawei/callback
HUAWEI_AUTH_URL=https://oauth-login.cloud.huawei.com/oauth2/v3/authorize
HUAWEI_TOKEN_URL=https://oauth-login.cloud.huawei.com/oauth2/v3/token
HUAWEI_HEALTH_BASE_URL=https://health-api.cloud.huawei.com/healthkit/v2

# Database
POSTGRES_USER=kemplu
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=kemplu
DATABASE_URL=postgresql+asyncpg://kemplu:change-this-local-password@postgres:5432/kemplu

# Redis
REDIS_URL=redis://redis:6379/0

# App
SECRET_KEY=change-this-session-secret
APP_VERSION=1.0.0
FRONTEND_URL=https://example.com
TIMEZONE=Asia/Jakarta
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend
VITE_API_BASE_URL=https://example.com
VITE_USE_MOCKS=false
VITE_ENABLE_DEMO_MODE=true
